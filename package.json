{
  "name": "kith",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "deploy:worker": "wrangler deploy --config wrangler.worker.jsonc",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "typecheck": "tsc --noEmit",
    "pipeline:check": "esbuild scripts/pipeline-check.ts --bundle --platform=node --format=esm --outfile=.wrangler/tmp/pipeline-check.mjs --log-level=warning && node --env-file-if-exists=.env .wrangler/tmp/pipeline-check.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.68.0",
    "@auth/drizzle-adapter": "^1.10.0",
    "@neondatabase/serverless": "^1.0.1",
    "drizzle-orm": "^0.44.5",
    "next": "^15.5.0",
    "next-auth": "^5.0.0-beta.29",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "web-push": "^3.6.7",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260903.1",
    "@opennextjs/cloudflare": "^1.6.0",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "drizzle-kit": "^0.31.4",
    "typescript": "^5.9.0",
    "wrangler": "^4.33.0"
  }
}
