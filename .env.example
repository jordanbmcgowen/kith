# --- database -------------------------------------------------------------
# Two strings, same Neon database. The difference is PgBouncer.
#
# DATABASE_URL  pooled   (host contains -pooler)  runtime: app + Worker
# DIRECT_URL    direct   (host has no -pooler)    drizzle-kit generate/migrate
#
# Migrations must NOT use the pooled host: PgBouncer in transaction mode has
# no session level advisory locks, and drizzle-kit takes one.
DATABASE_URL="postgresql://user:pass@ep-xxx-pooler.us-east-2.aws.neon.tech/kith?sslmode=require"
DIRECT_URL="postgresql://user:pass@ep-xxx.us-east-2.aws.neon.tech/kith?sslmode=require"

# --- auth -----------------------------------------------------------------
# openssl rand -base64 32
AUTH_SECRET=""
# Local dev only. The deployed value lives in wrangler.jsonc "vars" and must
# match the deployed origin exactly, or Google rejects the OAuth callback.
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# --- models ---------------------------------------------------------------
ANTHROPIC_API_KEY=""        # extraction
OPENAI_API_KEY=""           # whisper transcription + embeddings

# --- optional -------------------------------------------------------------
GOOGLE_PLACES_KEY=""        # turns coordinates into place names
VAPID_PUBLIC_KEY=""         # web push. npx web-push generate-vapid-keys
VAPID_PRIVATE_KEY=""
