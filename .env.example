# --- database -------------------------------------------------------------
# Neon pooled connection string. Use the -pooler host for the app.
DATABASE_URL="postgresql://user:pass@ep-xxx-pooler.us-east-2.aws.neon.tech/kith?sslmode=require"

# --- auth -----------------------------------------------------------------
# openssl rand -base64 32
AUTH_SECRET=""
