{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kith-processor",
  "main": "src/workers/process-capture.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],

  "r2_buckets": [{ "binding": "AUDIO", "bucket_name": "kith-audio" }],
  "queues": {
    "consumers": [{
      "queue": "kith-captures",
      "max_batch_size": 5,
      "max_batch_timeout": 10,
      "max_retries": 3,
      "dead_letter_queue": "kith-captures-dlq"
    }]
  },
  // 8am Central. Cron runs on UTC; the handler is a Phase 3 stub for now.
  "triggers": { "crons": ["0 13 * * *"] },
  "observability": { "enabled": true }
}
