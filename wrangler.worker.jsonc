{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kith-processor",
  "main": "src/workers/process-capture.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],

  // The fetch handler serves embeddings to the app over a service binding.
  // No public hostname: with workers.dev and preview URLs off, the only way
  // to reach it is from a Worker that declares the binding.
  "workers_dev": false,
  "preview_urls": false,

  "r2_buckets": [{ "binding": "AUDIO", "bucket_name": "kith-audio" }],
  "queues": {
    "producers": [{ "binding": "CAPTURE_QUEUE", "queue": "kith-captures" }],
    "consumers": [{
      "queue": "kith-captures",
      "max_batch_size": 5,
      "max_batch_timeout": 10,
      "max_retries": 3,
      "dead_letter_queue": "kith-captures-dlq"
    }]
  },
  // Durable outbox recovery, bounded to 100 dispatches per run.
  "triggers": { "crons": ["* * * * *"] },
  "observability": { "enabled": true }
}
